# Every credential here is generated by an ephemeral resource and handed to
# AWS through a write-only argument, so none of them is ever written to
# Terraform state or a plan file. The cost is that Terraform cannot read
# them back either: rotation is a version bump, not an edit. docs/adr/0001.

ephemeral "random_password" "db" {
  length  = 40
  special = false # goes inside a connection URL unescaped
}

ephemeral "random_password" "redis" {
  length  = 64
  special = false
}

ephemeral "random_password" "admin_api_key" {
  length  = 48
  special = false
}

locals {
  db_username = "hookrelay"
  db_name     = "hookrelay"
}

resource "aws_secretsmanager_secret" "database_url" {
  name_prefix             = "${var.name}/database-url-"
  description             = "hookrelay DATABASE_URL (TLS required)."
  kms_key_id              = aws_kms_key.this.arn
  recovery_window_in_days = 7
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "database_url" {
  secret_id                = aws_secretsmanager_secret.database_url.id
  secret_string_wo         = "postgresql://${local.db_username}:${ephemeral.random_password.db.result}@${aws_db_instance.this.address}:${aws_db_instance.this.port}/${local.db_name}?schema=public&sslmode=require"
  secret_string_wo_version = var.credentials_version
}

resource "aws_secretsmanager_secret" "redis_url" {
  name_prefix             = "${var.name}/redis-url-"
  description             = "hookrelay REDIS_URL (rediss://, TLS)."
  kms_key_id              = aws_kms_key.this.arn
  recovery_window_in_days = 7
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "redis_url" {
  secret_id                = aws_secretsmanager_secret.redis_url.id
  secret_string_wo         = "rediss://:${ephemeral.random_password.redis.result}@${aws_elasticache_replication_group.this.primary_endpoint_address}:${aws_elasticache_replication_group.this.port}"
  secret_string_wo_version = var.credentials_version
}

resource "aws_secretsmanager_secret" "admin_api_key" {
  name_prefix             = "${var.name}/admin-api-key-"
  description             = "hookrelay ADMIN_API_KEY, for creating applications. Read it from Secrets Manager; it is not a Terraform output."
  kms_key_id              = aws_kms_key.this.arn
  recovery_window_in_days = 7
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "admin_api_key" {
  secret_id                = aws_secretsmanager_secret.admin_api_key.id
  secret_string_wo         = ephemeral.random_password.admin_api_key.result
  secret_string_wo_version = var.credentials_version
}
